{
  "name": "action-dist-sync",
  "version": "0.1.0",
  "description": "Fork-safe dist/ syncing for JavaScript GitHub Actions: CI builds the bundle, same-repo PRs get it committed, fork PRs get it applied with one command.",
  "type": "module",
  "license": "MIT",
  "author": "John Ennis",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/John-E5/action-dist-sync.git"
  },
  "homepage": "https://github.com/John-E5/action-dist-sync#readme",
  "bugs": {
    "url": "https://github.com/John-E5/action-dist-sync/issues"
  },
  "keywords": [
    "github-actions",
    "javascript-action",
    "typescript-action",
    "dist",
    "ncc",
    "fork",
    "pull-request",
    "bundle",
    "ci",
    "maintainers"
  ],
  "bin": {
    "action-dist-sync": "dist/cli.js"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
